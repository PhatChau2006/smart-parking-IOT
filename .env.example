PORT=1884
MQTT_HOST=YOUR_CLUSTER.s1.eu.hivemq.cloud
MQTT_PORT=8883
# MQTT TLS is enabled in the MQTT BROKER config node. Disable there only for local test brokers.
MQTT_USERNAME=parking
MQTT_PASSWORD=CHANGE_ME
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only key. Legacy SUPABASE_SERVICE_ROLE_KEY is also supported.
SUPABASE_SECRET_KEY=
# false only for local LAN HTTP demonstrations. Use HTTPS + true for deployment.
COOKIE_SECURE=false
NODE_RED_CREDENTIAL_SECRET=REPLACE_WITH_RANDOM_SECRET
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Gmail App Password (2-Step Verification), not the normal account password.
ALERT_TO=
